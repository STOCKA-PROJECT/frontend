# Public site URL used for SEO/canonical tags. Defaults to https://stocka.es.
NUXT_PUBLIC_SITE_URL=https://stocka.es

# Stocka backend base URL (Spring Boot). Server-side only — el navegador
# nunca habla con este host directamente; pasa por /api/* (server/api/[...path].ts).
# Defaults to http://localhost:9095.
NUXT_API_BASE_URL=http://localhost:9095
